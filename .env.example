# Server-side provider credentials. Configure only the provider selected below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Current Mozaik model name, for example gpt-5.4-mini.
MOZAIK_MODEL=gpt-5.4-mini

# Optional Mozaik Cloud telemetry. Content redaction is the safe default.
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=
MOZAIK_REDACTION=content
