# Server-side provider credentials. Configure only the provider selected below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Current Mozaik model name. Flash-Lite has a free Gemini API tier.
MOZAIK_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=5
MOZAIK_MAX_MODEL_REACTIONS=3

# Optional Mozaik Cloud telemetry. Content redaction is the safe default.
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=
MOZAIK_REDACTION=content
